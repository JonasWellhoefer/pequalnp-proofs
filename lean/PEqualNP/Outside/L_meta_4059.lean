lemma mk (G : SimpleGraph (Fin 26)) (hA : ∀ u v : Fin 26, G.Adj u v ↔ adjB u.val v.val = true)
    (f g : List ℕ) (hg : good f g = true) : ∃ e : G ≃g G, ∀ i : Fin 26, e i = app f i := by
  have h := of_decide_eq_true hg
  refine ⟨⟨⟨app f, app g, h.1, h.2.1⟩, ?_⟩, fun i => rfl⟩
  intro u v
  show G.Adj (app f u) (app f v) ↔ G.Adj u v
  rw [hA, hA, h.2.2]

lemma main (G : SimpleGraph (Fin 26)) (hA : ∀ u v : Fin 26, G.Adj u v ↔ adjB u.val v.val = true)
    (a b : Fin 26) (hab : ¬ G.Adj a b) :
    ∃ e : G ≃g G, e a = (0 : Fin 26) ∧
      (e b = (0 : Fin 26) ∨ e b = (1 : Fin 26) ∨ e b = (14 : Fin 26)) := by
  obtain ⟨e1, he1⟩ := mk G hA _ _ (tA_good a).1
  have h1 : e1 a = (0 : Fin 26) := by rw [he1]; exact (tA_good a).2
  have hn : ¬ G.Adj (0 : Fin 26) (e1 b) := by
    rw [← h1]
    intro hc
    exact hab (e1.map_rel_iff.mp hc)
  have hb : adjB 0 (e1 b).val = false := by
    rw [hA] at hn
    simpa using hn
  obtain ⟨hg2, h20, h2b⟩ := tB_good (e1 b) hb
  obtain ⟨e2, he2⟩ := mk G hA _ _ hg2
  refine ⟨e1.trans e2, ?_, ?_⟩
  · show e2 (e1 a) = 0
    rw [h1, he2]
    exact h20
  · show e2 (e1 b) = 0 ∨ e2 (e1 b) = 1 ∨ e2 (e1 b) = 14
    rw [he2]
    exact h2b

end PEqualNP.Outside.L_meta_4059

