-- Incidence graph of the plane of order 3: points 0..12, lines 13..25, point p on line l when
-- p - l is 0, 1, 3 or 9 modulo 13. The proof lists explicit automorphisms as value tables and
-- checks them by evaluation: tA sends each vertex to 0, tB fixes 0 and sends a vertex that is
-- not a neighbour of 0 to 0, 1 or 14.

def dB (p l : ℕ) : Bool :=
  (p + 13 - l) % 13 == 0 || (p + 13 - l) % 13 == 1 || (p + 13 - l) % 13 == 3 ||
    (p + 13 - l) % 13 == 9

def adjB (a b : ℕ) : Bool :=
  (decide (a < 13) && decide (13 ≤ b) && dB a (b - 13)) ||
    (decide (b < 13) && decide (13 ≤ a) && dB b (a - 13))

def app (l : List ℕ) (i : Fin 26) : Fin 26 := ⟨l.getD i.val 0 % 26, Nat.mod_lt _ (by norm_num)⟩

def good (f g : List ℕ) : Bool :=
  decide ((∀ i : Fin 26, app g (app f i) = i) ∧ (∀ i : Fin 26, app f (app g i) = i) ∧
    ∀ i j : Fin 26, adjB (app f i).val (app f j).val = adjB i.val j.val)

